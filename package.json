{
  "name": "diffscope-extension",
  "displayName": "DiffScope",
  "description": "Просмотр истории и диффов git с лентами между колонками, как в WebStorm",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "media"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "diffscope.compareWith",
        "title": "Сравнить с…",
        "category": "DiffScope"
      },
      {
        "command": "diffscope.showLineHistory",
        "title": "Показать историю",
        "category": "DiffScope",
        "icon": "$(history)"
      },
      {
        "command": "diffscope.history.stop",
        "title": "Остановить поиск",
        "category": "DiffScope",
        "icon": "$(debug-stop)"
      },
      {
        "command": "diffscope.history.openInNewTab",
        "title": "Открыть в новой вкладке",
        "category": "DiffScope"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "diffscope.compareWith",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "3_compare@10"
        },
        {
          "command": "diffscope.showLineHistory",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "3_compare@11"
        }
      ],
      "editor/title/context": [
        {
          "command": "diffscope.compareWith",
          "when": "resourceScheme == file",
          "group": "3_compare@10"
        },
        {
          "command": "diffscope.showLineHistory",
          "when": "resourceScheme == file",
          "group": "3_compare@11"
        }
      ],
      "editor/context": [
        {
          "command": "diffscope.showLineHistory",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@99"
        },
        {
          "command": "diffscope.compareWith",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@100"
        }
      ],
      "commandPalette": [
        {
          "command": "diffscope.compareWith",
          "when": "resourceScheme == file"
        },
        {
          "command": "diffscope.showLineHistory",
          "when": "editorIsOpen && resourceScheme == file"
        },
        {
          "command": "diffscope.history.stop",
          "when": "diffscope.historyLoading"
        },
        {
          "command": "diffscope.history.openInNewTab",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "diffscope.history.stop",
          "when": "view == diffscope.history && diffscope.historyLoading",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "diffscope.history.openInNewTab",
          "when": "view == diffscope.history"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "diffscope",
          "title": "DiffScope",
          "icon": "media/diffscope.svg"
        }
      ]
    },
    "views": {
      "diffscope": [
        {
          "id": "diffscope.history",
          "name": "История"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "diffscope.history",
        "contents": "Выделите строки в редакторе и выберите «DiffScope: Показать историю» в контекстном меню — здесь появятся коммиты, которые их меняли. Без выделения — история всего файла.\n[Показать историю](command:diffscope.showLineHistory)"
      }
    ],
    "configuration": {
      "title": "DiffScope",
      "properties": {
        "diffscope.history.firstParent": {
          "type": "boolean",
          "default": false,
          "description": "История строк и файла: идти только по первому родителю merge-коммитов (основной ветке). Выключено — видны и коммиты влитых веток, в том числе тот, где строки появились."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "dev:webview": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p webview/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.115.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
