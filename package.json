{
  "name": "diffscope-extension",
  "displayName": "DiffScope",
  "description": "Просмотр истории и диффов git с лентами между колонками, как в WebStorm",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "diffscope.compareWith",
        "title": "Сравнить с…",
        "category": "DiffScope"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "diffscope.compareWith",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "3_compare@10"
        }
      ],
      "editor/title/context": [
        {
          "command": "diffscope.compareWith",
          "when": "resourceScheme == file",
          "group": "3_compare@10"
        }
      ],
      "editor/context": [
        {
          "command": "diffscope.compareWith",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@100"
        }
      ],
      "commandPalette": [
        {
          "command": "diffscope.compareWith",
          "when": "resourceScheme == file"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "dev:webview": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p webview/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.115.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
