{
  "name": "diffscope-extension",
  "displayName": "DiffScope",
  "description": "Просмотр истории и диффов git с лентами между колонками, как в WebStorm",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "media"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "diffscope.compareWith",
        "title": "Сравнить с…",
        "category": "DiffScope"
      },
      {
        "command": "diffscope.showFileHistory",
        "title": "Показать историю",
        "category": "DiffScope",
        "icon": "$(history)"
      },
      {
        "command": "diffscope.showLineHistory",
        "title": "Показать историю по строкам",
        "category": "DiffScope",
        "icon": "$(history)"
      },
      {
        "command": "diffscope.history.stop",
        "title": "Остановить поиск",
        "category": "DiffScope",
        "icon": "$(debug-stop)"
      },
      {
        "command": "diffscope.history.openInNewTab",
        "title": "Открыть в новой вкладке",
        "category": "DiffScope"
      },
      {
        "command": "diffscope.compareBranches",
        "title": "Сравнить ветки",
        "category": "DiffScope",
        "icon": "$(git-compare)"
      },
      {
        "command": "diffscope.changedFiles.open",
        "title": "Показать файл во вкладке сравнения",
        "category": "DiffScope"
      },
      {
        "command": "diffscope.changedFiles.openInNewTab",
        "title": "Открыть в отдельной вкладке",
        "category": "DiffScope"
      },
      {
        "command": "diffscope.changedFiles.refresh",
        "title": "Обновить",
        "category": "DiffScope",
        "icon": "$(refresh)"
      },
      {
        "command": "diffscope.changedFiles.swap",
        "title": "Поменять местами",
        "category": "DiffScope",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "diffscope.changedFiles.modePr",
        "title": "Режим: как в PR (только изменения ветки)",
        "category": "DiffScope",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "diffscope.changedFiles.modeDirect",
        "title": "Режим: прямое сравнение (все отличия)",
        "category": "DiffScope",
        "icon": "$(diff)"
      },
      {
        "command": "diffscope.changedFiles.viewAsList",
        "title": "Показать списком",
        "category": "DiffScope",
        "icon": "$(list-flat)"
      },
      {
        "command": "diffscope.changedFiles.viewAsTree",
        "title": "Показать деревом",
        "category": "DiffScope",
        "icon": "$(list-tree)"
      },
      {
        "command": "diffscope.showLog",
        "title": "Показать Git Log",
        "category": "DiffScope",
        "icon": "$(git-commit)"
      },
      {
        "command": "diffscope.history.showCommit",
        "title": "Посмотреть изменения",
        "category": "DiffScope",
        "icon": "$(diff-multiple)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "diffscope.file",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "3_compare@10"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "diffscope.file",
          "when": "resourceScheme == file",
          "group": "3_compare@10"
        }
      ],
      "editor/context": [
        {
          "submenu": "diffscope.editor",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@100"
        }
      ],
      "commandPalette": [
        {
          "command": "diffscope.compareWith",
          "when": "resourceScheme == file"
        },
        {
          "command": "diffscope.history.stop",
          "when": "diffscope.historyLoading"
        },
        {
          "command": "diffscope.history.openInNewTab",
          "when": "false"
        },
        {
          "command": "diffscope.changedFiles.open",
          "when": "false"
        },
        {
          "command": "diffscope.changedFiles.openInNewTab",
          "when": "false"
        },
        {
          "command": "diffscope.changedFiles.modePr",
          "when": "false"
        },
        {
          "command": "diffscope.changedFiles.modeDirect",
          "when": "false"
        },
        {
          "command": "diffscope.changedFiles.viewAsList",
          "when": "false"
        },
        {
          "command": "diffscope.changedFiles.viewAsTree",
          "when": "false"
        },
        {
          "command": "diffscope.changedFiles.swap",
          "when": "false"
        },
        {
          "command": "diffscope.changedFiles.refresh",
          "when": "false"
        },
        {
          "command": "diffscope.showFileHistory",
          "when": "editorIsOpen && resourceScheme == file"
        },
        {
          "command": "diffscope.showLineHistory",
          "when": "editorIsOpen && resourceScheme == file"
        },
        {
          "command": "diffscope.history.showCommit",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "diffscope.history.stop",
          "when": "view == diffscope.history && diffscope.historyLoading",
          "group": "navigation"
        },
        {
          "command": "diffscope.compareBranches",
          "when": "view == diffscope.changedFiles",
          "group": "navigation@1"
        },
        {
          "command": "diffscope.changedFiles.modePr",
          "when": "view == diffscope.changedFiles && diffscope.hasComparison && diffscope.compareMode == direct",
          "group": "navigation@2"
        },
        {
          "command": "diffscope.changedFiles.modeDirect",
          "when": "view == diffscope.changedFiles && diffscope.hasComparison && diffscope.compareMode == pr",
          "group": "navigation@2"
        },
        {
          "command": "diffscope.changedFiles.swap",
          "when": "view == diffscope.changedFiles && diffscope.hasComparison",
          "group": "navigation@3"
        },
        {
          "command": "diffscope.changedFiles.viewAsList",
          "when": "view == diffscope.changedFiles && diffscope.changedFilesAsTree",
          "group": "navigation@4"
        },
        {
          "command": "diffscope.changedFiles.viewAsTree",
          "when": "view == diffscope.changedFiles && !diffscope.changedFilesAsTree",
          "group": "navigation@4"
        },
        {
          "command": "diffscope.changedFiles.refresh",
          "when": "view == diffscope.changedFiles && diffscope.hasComparison",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "diffscope.history.showCommit",
          "when": "view == diffscope.history && viewItem == commit",
          "group": "1_open@1"
        },
        {
          "command": "diffscope.history.openInNewTab",
          "when": "view == diffscope.history",
          "group": "1_open@2"
        },
        {
          "command": "diffscope.changedFiles.openInNewTab",
          "when": "view == diffscope.changedFiles && viewItem == changedFile"
        }
      ],
      "scm/title": [
        {
          "command": "diffscope.compareBranches",
          "when": "scmProvider == git",
          "group": "navigation@100"
        },
        {
          "command": "diffscope.showLog",
          "when": "scmProvider == git",
          "group": "navigation@99"
        }
      ],
      "diffscope.editor": [
        {
          "command": "diffscope.compareWith",
          "group": "1_file@1"
        },
        {
          "command": "diffscope.showFileHistory",
          "group": "1_file@2"
        },
        {
          "command": "diffscope.showLineHistory",
          "group": "1_file@3"
        },
        {
          "command": "diffscope.compareBranches",
          "group": "9_branches@1"
        },
        {
          "command": "diffscope.showLog",
          "group": "9_branches@2"
        }
      ],
      "diffscope.file": [
        {
          "command": "diffscope.compareWith",
          "group": "1_file@1"
        },
        {
          "command": "diffscope.showFileHistory",
          "group": "1_file@2"
        },
        {
          "command": "diffscope.compareBranches",
          "group": "9_branches@1"
        },
        {
          "command": "diffscope.showLog",
          "group": "9_branches@2"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "diffscope",
          "title": "DiffScope",
          "icon": "media/diffscope.svg"
        }
      ]
    },
    "views": {
      "diffscope": [
        {
          "id": "diffscope.history",
          "name": "История"
        },
        {
          "id": "diffscope.changedFiles",
          "name": "Изменённые файлы"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "diffscope.history",
        "contents": "Выберите в контекстном меню редактора «DiffScope → Показать историю по строкам» (выделенные строки) или «Показать историю» (весь файл) — здесь появятся коммиты.\n[Показать историю файла](command:diffscope.showFileHistory)"
      },
      {
        "view": "diffscope.changedFiles",
        "contents": "Сравните две ветки — здесь появятся отличающиеся файлы.\n[Сравнить ветки](command:diffscope.compareBranches)"
      }
    ],
    "configuration": {
      "title": "DiffScope",
      "properties": {
        "diffscope.history.firstParent": {
          "type": "boolean",
          "default": false,
          "description": "История строк и файла: идти только по первому родителю merge-коммитов (основной ветке). Выключено — видны и коммиты влитых веток, в том числе тот, где строки появились."
        },
        "diffscope.branchCompare.defaultMode": {
          "type": "string",
          "enum": [
            "pr",
            "direct"
          ],
          "default": "pr",
          "enumDescriptions": [
            "Как в PR (A...B): только изменения правой стороны с момента расхождения",
            "Прямое (A..B): все отличия двух ревизий"
          ],
          "description": "Сравнение веток: режим по умолчанию."
        }
      }
    },
    "submenus": [
      {
        "id": "diffscope.editor",
        "label": "DiffScope"
      },
      {
        "id": "diffscope.file",
        "label": "DiffScope"
      }
    ]
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "dev:webview": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p webview/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.115.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
